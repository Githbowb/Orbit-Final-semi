<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header with Profile Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_node_secondary">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/change_username"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="#FF6B35" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_username"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/utf8_support_hint"
                android:textColor="#8E94A8"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Username Input Field -->
    <EditText
        android:id="@+id/et_dialog_username"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0D0E15"
        android:hint="@string/choose_username"
        android:inputType="textMultiLine|textNoSuggestions"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#5A6178"
        android:textSize="14.5sp" />

    <TextView
        android:id="@+id/tv_dialog_error_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/enter_valid_username"
        android:textColor="#FF5252"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <!-- Buttons: Cancel & Save Changes -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_dialog_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:text="@string/cancel"
            android:textColor="#8E94A8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_dialog_save"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:backgroundTint="#FF6B35"
            android:paddingHorizontal="20dp"
            android:text="@string/save_changes"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
