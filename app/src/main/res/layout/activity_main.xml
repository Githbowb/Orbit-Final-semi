<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_stage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_orbit_gradient">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launch_control"
                android:textColor="@color/signal_orange"
                android:textSize="10.5sp"
                android:letterSpacing="0.2"
                android:textAlignment="viewStart"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_orbit"
                android:textColor="@color/ink_light"
                android:textSize="22sp"
                android:textAlignment="viewStart"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_in_orbit_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textColor="@color/signal_orange"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/in_orbit"
                android:textColor="@color/ink_dim"
                android:textSize="10sp"
                android:letterSpacing="0.1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Orbital Center Stage Frame -->
    <FrameLayout
        android:id="@+id/orbit_center_stage"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:layout_constraintTop_toBottomOf="@id/header_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp">

        <!-- Outer Track (t3: 300dp) -->
        <View
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card" />

        <!-- Mid Track (t2: 210dp) -->
        <View
            android:layout_width="210dp"
            android:layout_height="210dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card" />

        <!-- Inner Track (t1: 120dp) -->
        <View
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_card" />

        <!-- Glowing Core Center -->
        <View
            android:id="@+id/core_glowing_center"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_node_primary" />
    </FrameLayout>

    <!-- Bottom Dock Bar -->
    <LinearLayout
        android:id="@+id/bottom_dock"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_dock"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tab_orbit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="ORBIT"
            android:textColor="@color/signal_orange"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_vault"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="VAULT"
            android:textColor="@color/ink_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_tools"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="TOOLS"
            android:textColor="@color/ink_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tab_setup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="SETUP"
            android:textColor="@color/ink_dim"
            android:textSize="11sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
